{
  "entities": {
    "InventoryCount": {
      "title": "InventoryCount",
      "description": "A single physical stock count record submitted by a store associate",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique count record identifier"
        },
        "username": {
          "type": "string",
          "description": "Display name of the user who performed the count"
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who performed the count"
        },
        "store": {
          "type": "string",
          "description": "Store name or code where the count took place"
        },
        "storeId": {
          "type": "string",
          "description": "Store identifier"
        },
        "sku": {
          "type": "string",
          "description": "Stock Keeping Unit code"
        },
        "barcode": {
          "type": "string",
          "description": "Scanned or manually entered barcode"
        },
        "itemDescription": {
          "type": "string",
          "description": "Description of the scanned item"
        },
        "countedQuantity": {
          "type": "number",
          "description": "Physical quantity counted (>= 0)"
        },
        "condition": {
          "type": "string",
          "enum": ["Good", "Damage"],
          "description": "Classification of the counted item condition (Good or Damage)"
        },
        "remarks": {
          "type": "string",
          "description": "Optional notes or damage remarks"
        },
        "location": {
          "type": "string",
          "description": "Physical shelf, aisle, bin, or bay location barcode/code"
        },
        "date": {
          "type": "string",
          "description": "Date of count in YYYY-MM-DD format"
        },
        "time": {
          "type": "string",
          "description": "Time of count in HH:mm:ss format"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the record was saved"
        },
        "status": {
          "type": "string",
          "enum": ["active", "voided"],
          "description": "Record status (active or voided soft-delete)"
        },
        "version": {
          "type": "number",
          "description": "Optimistic concurrency revision number"
        },
        "originalQuantity": {
          "type": "number",
          "description": "Original submitted quantity preserved across corrections"
        },
        "originalLocation": {
          "type": "string",
          "description": "Original submitted location preserved across corrections"
        },
        "voidReason": {
          "type": "string",
          "description": "Supervisor-approved reason for voiding the count"
        },
        "countRound": {
          "type": "number",
          "description": "Count round (1 for initial count, 2 for variance second count)"
        },
        "recountTaskId": {
          "type": "string",
          "description": "Reference to LocationRecountTask ID for second counts"
        },
        "countType": {
          "type": "string",
          "enum": ["cycle", "annual"],
          "description": "Counting mode: cycle (Cycle Count) or annual (Annual Inventory Count)"
        },
        "sessionId": {
          "type": "string",
          "description": "Counting session identifier isolating Cycle Count vs Annual Inventory Count data"
        },
        "cutoffDate": {
          "type": "string",
          "description": "Cut-off date for the counting session (YYYY-MM-DD)"
        }
      },
      "required": ["username", "userId", "store", "sku", "countedQuantity", "date", "time"]
    },
    "Product": {
      "title": "Product",
      "description": "Product catalog item with SKU and barcode mapping",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product catalog ID"
        },
        "sku": {
          "type": "string",
          "description": "Unique SKU code"
        },
        "barcode": {
          "type": "string",
          "description": "Barcode number (EAN, UPC, Code128)"
        },
        "description": {
          "type": "string",
          "description": "Product item title and description"
        },
        "category": {
          "type": "string",
          "description": "Merchandising category"
        },
        "unit": {
          "type": "string",
          "description": "Inventory unit of measure (e.g. pcs, box, kg)"
        }
      },
      "required": ["sku", "barcode", "description"]
    },
    "Store": {
      "title": "Store",
      "description": "Retail store location",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Store document ID"
        },
        "storeId": {
          "type": "string",
          "description": "Store code (e.g., ST-101)"
        },
        "name": {
          "type": "string",
          "description": "Retail branch store name"
        },
        "location": {
          "type": "string",
          "description": "City or mall location"
        }
      },
      "required": ["storeId", "name"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role and preferences",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User ID matching auth.uid"
        },
        "username": {
          "type": "string",
          "description": "Display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "role": {
          "type": "string",
          "enum": ["counter", "ops_counter", "supervisor", "ops_supervisor", "audit", "admin"],
          "description": "User role: counter, ops_counter, supervisor, ops_supervisor, audit, or admin"
        },
        "defaultStore": {
          "type": "string",
          "description": "Default assigned store"
        }
      },
      "required": ["username", "email"]
    },
    "ManagedUser": {
      "title": "ManagedUser",
      "description": "User provisioned and assigned to a retail store by Administrator",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Managed user identifier"
        },
        "username": {
          "type": "string",
          "description": "Username or login handle"
        },
        "displayName": {
          "type": "string",
          "description": "Full display name"
        },
        "password": {
          "type": "string",
          "description": "User access credentials"
        },
        "role": {
          "type": "string",
          "enum": ["counter", "ops_counter", "supervisor", "ops_supervisor", "audit", "admin"],
          "description": "Assigned role"
        },
        "assignedStoreId": {
          "type": "string",
          "description": "Designated retail store identifier"
        },
        "assignedStoreName": {
          "type": "string",
          "description": "Designated retail store branch name"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether user is active"
        }
      },
      "required": ["username", "displayName", "role", "assignedStoreId", "assignedStoreName"]
    },
    "CorrectionRequest": {
      "title": "CorrectionRequest",
      "description": "Request to correct or void a submitted inventory count, requiring supervisor approval",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique correction request ID" },
        "requestType": { "type": "string", "enum": ["correction", "void"], "description": "Type of request" },
        "inventoryCountId": { "type": "string", "description": "Related inventory_counts document ID" },
        "targetVersion": { "type": "number", "description": "Target record version for concurrency guard" },
        "store": { "type": "string", "description": "Store name" },
        "storeId": { "type": "string", "description": "Store identifier" },
        "sku": { "type": "string", "description": "Item SKU" },
        "reason": { "type": "string", "description": "Mandatory reason for correction or void" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Approval workflow status" },
        "requestedById": { "type": "string", "description": "Requester user ID" },
        "requestedByUsername": { "type": "string", "description": "Requester display name" },
        "requestedAt": { "type": "number", "description": "System timestamp of request" },
        "reviewedById": { "type": "string", "description": "Reviewer user ID" },
        "reviewedByUsername": { "type": "string", "description": "Reviewer display name" },
        "rejectionReason": { "type": "string", "description": "Mandatory reason when rejected" }
      },
      "required": ["id", "requestType", "inventoryCountId", "targetVersion", "reason", "status", "requestedById", "requestedByUsername", "requestedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable, append-only audit trail event for inventory actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique audit transaction ID" },
        "inventoryCountId": { "type": "string", "description": "Related inventory_counts transaction ID" },
        "correctionRequestId": { "type": "string", "description": "Related correction request ID if applicable" },
        "store": { "type": "string", "description": "Store name" },
        "storeId": { "type": "string", "description": "Store ID" },
        "sku": { "type": "string", "description": "Item ID / SKU" },
        "itemDescription": { "type": "string", "description": "Item description" },
        "location": { "type": "string", "description": "Inventory location" },
        "originalValue": { "type": "string", "description": "Before-change snapshot summary" },
        "newValue": { "type": "string", "description": "After-change snapshot summary" },
        "action": {
          "type": "string",
          "enum": ["COUNT_SUBMITTED", "CORRECTION_REQUESTED", "VOID_REQUESTED", "CORRECTION_APPROVED", "CORRECTION_REJECTED", "QUANTITY_CHANGED", "LOCATION_CHANGED", "ITEM_DETAILS_CHANGED", "RECORD_VOIDED", "VOID_REJECTED", "COUNTS_PURGED", "LOCATION_DONE_SUBMITTED", "LOCATION_VERIFIED", "LOCATION_RECOUNT_FLAGGED", "RECOUNT_TASK_OPENED", "RECOUNT_COUNTER_ASSIGNED", "SECOND_COUNT_SUBMITTED", "SECOND_COUNT_VERIFIED", "SECOND_COUNT_REOPENED", "LOCATION_TAG_CREATED", "LOCATION_TAG_REQUESTED", "LOCATION_TAG_APPROVED", "LOCATION_TAG_REJECTED", "COUNT_FINALIZED", "COUNT_REOPENED", "COUNT_SESSION_CREATED", "COUNT_SESSION_CLOSED", "COUNT_SESSION_REOPENED"],
          "description": "Action performed"
        },
        "approvalStatus": { "type": "string", "enum": ["N/A", "Pending", "Approved", "Rejected"] },
        "reason": { "type": "string", "description": "Reason for change or submission" },
        "requestedBy": { "type": "string", "description": "User who initiated the action" },
        "requestedById": { "type": "string", "description": "UID of requester" },
        "reviewedBy": { "type": "string", "description": "Supervisor who approved or rejected" },
        "timestamp": { "type": "number", "description": "System-generated timestamp" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "time": { "type": "string", "description": "HH:mm:ss" },
        "countType": { "type": "string", "enum": ["cycle", "annual"] },
        "sessionId": { "type": "string" },
        "cutoffDate": { "type": "string" }
      },
      "required": ["id", "inventoryCountId", "sku", "itemDescription", "originalValue", "newValue", "action", "reason", "requestedBy", "requestedById", "timestamp", "date", "time"]
    },
    "LocationVerification": {
      "title": "LocationVerification",
      "description": "Supervisor verification state for all inventory counts in a specific store location",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Deterministic store+location verification ID" },
        "storeId": { "type": "string", "description": "Store identifier" },
        "storeName": { "type": "string", "description": "Store name" },
        "location": { "type": "string", "description": "Physical shelf/aisle/bin location" },
        "status": { "type": "string", "enum": ["pending_verification", "verified", "recount_needed"], "description": "Verification status" },
        "submittedById": { "type": "string", "description": "Counter UID who marked location done" },
        "submittedByName": { "type": "string", "description": "Counter name" },
        "submittedAt": { "type": "number", "description": "Submission timestamp" },
        "itemCountSnapshot": { "type": "number", "description": "Count records snapshot" },
        "totalUnitsSnapshot": { "type": "number", "description": "Total units snapshot" },
        "verifiedById": { "type": "string", "description": "Supervisor UID" },
        "verifiedByName": { "type": "string", "description": "Supervisor name" },
        "supervisorNotes": { "type": "string", "description": "Verification or recount notes" }
      },
      "required": ["id", "storeId", "storeName", "location", "status", "submittedById", "submittedByName", "submittedAt"]
    },
    "LocationRecountTask": {
      "title": "LocationRecountTask",
      "description": "Per-location second count (variance recount) task with excluded first-round counters",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Deterministic store+location recount task ID" },
        "storeId": { "type": "string", "description": "Store identifier" },
        "storeName": { "type": "string", "description": "Store name" },
        "location": { "type": "string", "description": "Physical shelf/aisle/bin location" },
        "status": { "type": "string", "enum": ["open", "pending_review", "verified"], "description": "Second count lifecycle status" },
        "excludedCounterIds": { "type": "array", "description": "User IDs of Round 1 counters excluded from recounting this location" },
        "excludedCounterNames": { "type": "array", "description": "Display names of Round 1 counters excluded from recounting this location" },
        "openedById": { "type": "string", "description": "Supervisor/Admin UID who opened the recount" },
        "openedByName": { "type": "string", "description": "Supervisor/Admin name" },
        "openedAt": { "type": "number", "description": "Timestamp when recount was opened" },
        "assignedCounterId": { "type": "string", "description": "Optional assigned Round 2 counter UID chosen by Supervisor Ops" },
        "assignedCounterName": { "type": "string", "description": "Optional assigned Round 2 counter display name" },
        "assignedCounterRole": { "type": "string", "description": "Optional assigned Round 2 counter role" },
        "assignedById": { "type": "string", "description": "Supervisor Ops UID who assigned the counter" },
        "assignedByName": { "type": "string", "description": "Supervisor Ops name who assigned the counter" },
        "assignedAt": { "type": "number", "description": "Timestamp when counter was assigned" },
        "submittedById": { "type": "string", "description": "Eligible Round 2 counter UID" },
        "submittedByName": { "type": "string", "description": "Eligible Round 2 counter name" },
        "verifiedById": { "type": "string", "description": "Supervisor UID verifying Round 2 count" },
        "verifiedByName": { "type": "string", "description": "Supervisor name" },
        "supervisorNotes": { "type": "string", "description": "Notes on recount verification or reopening" }
      },
      "required": ["id", "storeId", "storeName", "location", "status", "excludedCounterIds", "openedById", "openedByName", "openedAt"]
    },
    "LocationTag": {
      "title": "LocationTag",
      "description": "Standardized clickable location tag created by Admin or requested by Supervisor pending Admin approval",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Deterministic store+name location tag ID" },
        "storeId": { "type": "string", "description": "Store identifier" },
        "storeName": { "type": "string", "description": "Store name" },
        "name": { "type": "string", "description": "Display location tag name (e.g., Aisle 1 - Shelf A)" },
        "zone": { "type": "string", "description": "Optional department or floor zone" },
        "code": { "type": "string", "description": "Optional barcode or location tag code" },
        "status": { "type": "string", "enum": ["approved", "pending_approval", "rejected"], "description": "Approval state of location tag" },
        "createdById": { "type": "string", "description": "Creator or requester UID" },
        "createdByName": { "type": "string", "description": "Creator or requester name" },
        "createdByRole": { "type": "string", "enum": ["counter", "ops_counter", "supervisor", "ops_supervisor", "audit", "admin"] },
        "createdAt": { "type": "number", "description": "Creation/request timestamp" },
        "approvedById": { "type": "string", "description": "Admin UID who approved or rejected" },
        "approvedByName": { "type": "string", "description": "Admin name" },
        "rejectionReason": { "type": "string", "description": "Reason provided when rejecting a supervisor location request" },
        "notes": { "type": "string", "description": "Optional supervisor request notes" }
      },
      "required": ["id", "storeId", "storeName", "name", "status", "createdById", "createdByName", "createdByRole", "createdAt"]
    },
    "StoreCountFinalization": {
      "title": "StoreCountFinalization",
      "description": "Tracks whether a retail store's counting (Round 1 + Round 2 recounts) is finalized so Supervisors can unlock System Balance review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Deterministic store finalization ID" },
        "storeId": { "type": "string", "description": "Store identifier" },
        "storeName": { "type": "string", "description": "Store name" },
        "status": { "type": "string", "enum": ["counting", "finalized"], "description": "Counting session status" },
        "finalizedById": { "type": "string", "description": "UID of supervisor or admin who finalized counting" },
        "finalizedByName": { "type": "string", "description": "Display name of user who finalized counting" },
        "finalizedByRole": { "type": "string", "enum": ["supervisor", "ops_supervisor", "admin"] },
        "finalizedAt": { "type": "number", "description": "Timestamp when counting was finalized" },
        "reopenedById": { "type": "string", "description": "Admin UID if counting was reopened" },
        "reopenedByName": { "type": "string", "description": "Admin display name if reopened" },
        "reopenedByRole": { "type": "string", "enum": ["admin"] },
        "reopenedAt": { "type": "number", "description": "Timestamp when counting was reopened" },
        "notes": { "type": "string", "description": "Optional notes" },
        "countType": { "type": "string", "enum": ["cycle", "annual"] },
        "sessionId": { "type": "string" },
        "cutoffDate": { "type": "string" }
      },
      "required": ["id", "storeId", "storeName", "status"]
    },
    "CountingSession": {
      "title": "CountingSession",
      "description": "Cycle Count or Annual Inventory Count session with cut-off date and open/closed lifecycle",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Counting session ID" },
        "countType": { "type": "string", "enum": ["cycle", "annual"], "description": "Cycle Count or Annual Inventory Count" },
        "title": { "type": "string", "description": "Session display title" },
        "cutoffDate": { "type": "string", "description": "Official cut-off date (YYYY-MM-DD)" },
        "storeId": { "type": "string", "description": "Assigned storeId or ALL" },
        "storeName": { "type": "string", "description": "Store scope label" },
        "status": { "type": "string", "enum": ["active", "closed"], "description": "Session status" },
        "createdById": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdByRole": { "type": "string", "enum": ["admin", "supervisor", "ops_supervisor"] },
        "createdAt": { "type": "number" },
        "closedAt": { "type": "number" },
        "closedById": { "type": "string" },
        "closedByName": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "countType", "title", "cutoffDate", "storeId", "storeName", "status", "createdById", "createdByName", "createdByRole", "createdAt"]
    }
  },
  "firestore": {
    "/inventory_counts/{countId}": {
      "schema": {
        "$ref": "#/entities/InventoryCount"
      },
      "description": "Collection of recorded inventory counts"
    },
    "/correction_requests/{requestId}": {
      "schema": {
        "$ref": "#/entities/CorrectionRequest"
      },
      "description": "Correction and void requests requiring supervisor approval"
    },
    "/audit_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/AuditLog"
      },
      "description": "Immutable append-only audit trail logs"
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Product master catalog for barcode and SKU lookups"
    },
    "/stores/{storeId}": {
      "schema": {
        "$ref": "#/entities/Store"
      },
      "description": "Retail stores directory"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Registered app users and counter profiles"
    },
    "/managed_users/{userId}": {
      "schema": {
        "$ref": "#/entities/ManagedUser"
      },
      "description": "Admin provisioned user accounts with designated store assignments"
    },
    "/location_verifications/{verificationId}": {
      "schema": {
        "$ref": "#/entities/LocationVerification"
      },
      "description": "Per-location count verification records submitted by counters and checked by supervisors"
    },
    "/location_recounts/{recountId}": {
      "schema": {
        "$ref": "#/entities/LocationRecountTask"
      },
      "description": "Per-location second count variance recount tasks with segregation of duties"
    },
    "/location_tags/{tagId}": {
      "schema": {
        "$ref": "#/entities/LocationTag"
      },
      "description": "Admin-defined and supervisor-requested clickable location tags per store"
    },
    "/count_finalizations/{finalizationId}": {
      "schema": {
        "$ref": "#/entities/StoreCountFinalization"
      },
      "description": "Per-store counting finalization status governing when supervisors can view system balance"
    },
    "/counting_sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/CountingSession"
      },
      "description": "Cycle Count and Annual Inventory Count sessions with cut-off dates and close/finalization status"
    }
  }
}
