{
  "entities": {
    "InventoryCount": {
      "title": "InventoryCount",
      "description": "A single physical stock count record submitted by a store associate",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique count record identifier"
        },
        "username": {
          "type": "string",
          "description": "Display name of the user who performed the count"
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who performed the count"
        },
        "store": {
          "type": "string",
          "description": "Store name or code where the count took place"
        },
        "storeId": {
          "type": "string",
          "description": "Store identifier"
        },
        "sku": {
          "type": "string",
          "description": "Stock Keeping Unit code"
        },
        "barcode": {
          "type": "string",
          "description": "Scanned or manually entered barcode"
        },
        "itemDescription": {
          "type": "string",
          "description": "Description of the scanned item"
        },
        "countedQuantity": {
          "type": "number",
          "description": "Physical quantity counted (>= 0)"
        },
        "condition": {
          "type": "string",
          "enum": ["Good", "Damage"],
          "description": "Classification of the counted item condition (Good or Damage)"
        },
        "remarks": {
          "type": "string",
          "description": "Optional notes or damage remarks"
        },
        "location": {
          "type": "string",
          "description": "Physical shelf, aisle, bin, or bay location barcode/code"
        },
        "date": {
          "type": "string",
          "description": "Date of count in YYYY-MM-DD format"
        },
        "time": {
          "type": "string",
          "description": "Time of count in HH:mm:ss format"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the record was saved"
        },
        "status": {
          "type": "string",
          "enum": ["active", "voided"],
          "description": "Record status (active or voided soft-delete)"
        },
        "version": {
          "type": "number",
          "description": "Optimistic concurrency revision number"
        },
        "originalQuantity": {
          "type": "number",
          "description": "Original submitted quantity preserved across corrections"
        },
        "originalLocation": {
          "type": "string",
          "description": "Original submitted location preserved across corrections"
        },
        "voidReason": {
          "type": "string",
          "description": "Supervisor-approved reason for voiding the count"
        }
      },
      "required": ["username", "userId", "store", "sku", "countedQuantity", "date", "time"]
    },
    "Product": {
      "title": "Product",
      "description": "Product catalog item with SKU and barcode mapping",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product catalog ID"
        },
        "sku": {
          "type": "string",
          "description": "Unique SKU code"
        },
        "barcode": {
          "type": "string",
          "description": "Barcode number (EAN, UPC, Code128)"
        },
        "description": {
          "type": "string",
          "description": "Product item title and description"
        },
        "category": {
          "type": "string",
          "description": "Merchandising category"
        },
        "unit": {
          "type": "string",
          "description": "Inventory unit of measure (e.g. pcs, box, kg)"
        }
      },
      "required": ["sku", "barcode", "description"]
    },
    "Store": {
      "title": "Store",
      "description": "Retail store location",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Store document ID"
        },
        "storeId": {
          "type": "string",
          "description": "Store code (e.g., ST-101)"
        },
        "name": {
          "type": "string",
          "description": "Retail branch store name"
        },
        "location": {
          "type": "string",
          "description": "City or mall location"
        }
      },
      "required": ["storeId", "name"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role and preferences",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User ID matching auth.uid"
        },
        "username": {
          "type": "string",
          "description": "Display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "role": {
          "type": "string",
          "enum": ["counter", "ops_counter", "supervisor", "ops_supervisor", "audit", "admin"],
          "description": "User role: counter, ops_counter, supervisor, ops_supervisor, audit, or admin"
        },
        "defaultStore": {
          "type": "string",
          "description": "Default assigned store"
        }
      },
      "required": ["username", "email"]
    },
    "ManagedUser": {
      "title": "ManagedUser",
      "description": "User provisioned and assigned to a retail store by Administrator",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Managed user identifier"
        },
        "username": {
          "type": "string",
          "description": "Username or login handle"
        },
        "displayName": {
          "type": "string",
          "description": "Full display name"
        },
        "password": {
          "type": "string",
          "description": "User access credentials"
        },
        "role": {
          "type": "string",
          "enum": ["counter", "ops_counter", "supervisor", "ops_supervisor", "audit", "admin"],
          "description": "Assigned role"
        },
        "assignedStoreId": {
          "type": "string",
          "description": "Designated retail store identifier"
        },
        "assignedStoreName": {
          "type": "string",
          "description": "Designated retail store branch name"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether user is active"
        }
      },
      "required": ["username", "displayName", "role", "assignedStoreId", "assignedStoreName"]
    },
    "CorrectionRequest": {
      "title": "CorrectionRequest",
      "description": "Request to correct or void a submitted inventory count, requiring supervisor approval",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique correction request ID" },
        "requestType": { "type": "string", "enum": ["correction", "void"], "description": "Type of request" },
        "inventoryCountId": { "type": "string", "description": "Related inventory_counts document ID" },
        "targetVersion": { "type": "number", "description": "Target record version for concurrency guard" },
        "store": { "type": "string", "description": "Store name" },
        "storeId": { "type": "string", "description": "Store identifier" },
        "sku": { "type": "string", "description": "Item SKU" },
        "reason": { "type": "string", "description": "Mandatory reason for correction or void" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Approval workflow status" },
        "requestedById": { "type": "string", "description": "Requester user ID" },
        "requestedByUsername": { "type": "string", "description": "Requester display name" },
        "requestedAt": { "type": "number", "description": "System timestamp of request" },
        "reviewedById": { "type": "string", "description": "Reviewer user ID" },
        "reviewedByUsername": { "type": "string", "description": "Reviewer display name" },
        "rejectionReason": { "type": "string", "description": "Mandatory reason when rejected" }
      },
      "required": ["id", "requestType", "inventoryCountId", "targetVersion", "reason", "status", "requestedById", "requestedByUsername", "requestedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable, append-only audit trail event for inventory actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique audit transaction ID" },
        "inventoryCountId": { "type": "string", "description": "Related inventory_counts transaction ID" },
        "correctionRequestId": { "type": "string", "description": "Related correction request ID if applicable" },
        "store": { "type": "string", "description": "Store name" },
        "storeId": { "type": "string", "description": "Store ID" },
        "sku": { "type": "string", "description": "Item ID / SKU" },
        "itemDescription": { "type": "string", "description": "Item description" },
        "location": { "type": "string", "description": "Inventory location" },
        "originalValue": { "type": "string", "description": "Before-change snapshot summary" },
        "newValue": { "type": "string", "description": "After-change snapshot summary" },
        "action": {
          "type": "string",
          "enum": ["COUNT_SUBMITTED", "CORRECTION_REQUESTED", "VOID_REQUESTED", "CORRECTION_APPROVED", "CORRECTION_REJECTED", "QUANTITY_CHANGED", "LOCATION_CHANGED", "ITEM_DETAILS_CHANGED", "RECORD_VOIDED", "VOID_REJECTED"],
          "description": "Action performed"
        },
        "approvalStatus": { "type": "string", "enum": ["N/A", "Pending", "Approved", "Rejected"] },
        "reason": { "type": "string", "description": "Reason for change or submission" },
        "requestedBy": { "type": "string", "description": "User who initiated the action" },
        "requestedById": { "type": "string", "description": "UID of requester" },
        "reviewedBy": { "type": "string", "description": "Supervisor who approved or rejected" },
        "timestamp": { "type": "number", "description": "System-generated timestamp" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "time": { "type": "string", "description": "HH:mm:ss" }
      },
      "required": ["id", "inventoryCountId", "sku", "itemDescription", "originalValue", "newValue", "action", "reason", "requestedBy", "requestedById", "timestamp", "date", "time"]
    }
  },
  "firestore": {
    "/inventory_counts/{countId}": {
      "schema": {
        "$ref": "#/entities/InventoryCount"
      },
      "description": "Collection of recorded inventory counts"
    },
    "/correction_requests/{requestId}": {
      "schema": {
        "$ref": "#/entities/CorrectionRequest"
      },
      "description": "Correction and void requests requiring supervisor approval"
    },
    "/audit_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/AuditLog"
      },
      "description": "Immutable append-only audit trail logs"
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Product master catalog for barcode and SKU lookups"
    },
    "/stores/{storeId}": {
      "schema": {
        "$ref": "#/entities/Store"
      },
      "description": "Retail stores directory"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Registered app users and counter profiles"
    },
    "/managed_users/{userId}": {
      "schema": {
        "$ref": "#/entities/ManagedUser"
      },
      "description": "Admin provisioned user accounts with designated store assignments"
    }
  }
}
