rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCount(data) {
      return data.keys().hasAll(['username', 'userId', 'store', 'sku', 'countedQuantity', 'date', 'time']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.countedQuantity is number &&
             data.countedQuantity >= 0 &&
             data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 120 &&
             data.store is string && data.store.size() > 0 && data.store.size() <= 120;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['sku', 'barcode', 'description']) &&
             data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
             data.barcode is string && data.barcode.size() > 0 && data.barcode.size() <= 100 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 300;
    }

    function isValidStore(data) {
      return data.keys().hasAll(['storeId', 'name']) &&
             data.storeId is string && data.storeId.size() > 0 && data.storeId.size() <= 64 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150;
    }

    function isValidManagedUser(data) {
      return data.keys().hasAll(['username', 'displayName', 'role', 'assignedStoreId', 'assignedStoreName']) &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 120 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 150 &&
             data.role in ['counter', 'ops_counter', 'supervisor', 'ops_supervisor', 'admin'];
    }

    // Connection health check
    match /test/connection {
      allow read: if true;
    }

    // Inventory Counts Collection
    // Credential-provisioned devices sync without requiring a Firebase Auth token; writes are schema-validated.
    match /inventory_counts/{countId} {
      allow read: if true;
      allow create, update: if isValidId(countId) && isValidCount(request.resource.data);
      allow delete: if isValidId(countId);
    }

    // Products Master Catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isValidId(productId);
    }

    // Retail Stores
    match /stores/{storeId} {
      allow read: if true;
      allow create, update: if isValidId(storeId) && isValidStore(request.resource.data);
      allow delete: if isValidId(storeId);
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
    }

    // Managed Users (Created and Assigned by Admin)
    match /managed_users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidManagedUser(request.resource.data);
      allow delete: if isValidId(userId);
    }
  }
}
